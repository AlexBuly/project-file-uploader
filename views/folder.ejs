<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Folder</title>
</head>
<body>
    <form
  action="/folders/<%= folder.id %>/upload"
  method="POST"
  enctype="multipart/form-data"
>
  <input type="file" name="file" required />
  <button>Upload</button>
</form>

<ul>
  <% folder.files.forEach(file => { %>
    <li>
      <a href="/uploads/<%= file.filename %>">
        <%= file.filename %>
      </a>

      <form method="POST" action="/folders/files/<%= file.id %>/delete">
        <button>Delete</button>
      </form>
    </li>
  <% }) %>
</ul>

<a href="/folders">Back</a>
</body>
</html>